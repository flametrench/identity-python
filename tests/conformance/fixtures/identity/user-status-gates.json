      "id": "user_status.verify_mfa.suspended_refused",
      "description": "A suspended user's valid TOTP code is refused (`InvalidCredentialError`, conflated with proof failure; ADR 0029).",
      "users": [],
      "steps": [
        {
          "op": "set_clock",
          "input": {
            "now": "2026-01-01T00:00:00Z"
          }
        },
        {
          "op": "create_user",
          "input": {},
          "captures": {
            "usr_id": "user.id"
          }
        },
        {
          "op": "enroll_totp_factor",
          "input": {
            "usr_id": "{usr_id}"
          },
          "captures": {
            "mfa_id": "factor.id",
            "secret": "secret"
          }
        },
        {
          "op": "compute_totp_code",
          "input": {
            "secret": "{secret}"
          },
          "captures": {
            "enroll_code": "code"
          }
        },
        {
          "op": "confirm_totp_factor",
          "input": {
            "mfa_id": "{mfa_id}",
            "code": "{enroll_code}"
          }
        },
        {
          "op": "set_clock",
          "input": {
            "now": "2026-01-01T00:01:00Z"
          }
        },
        {
          "op": "suspend_user",
          "input": {
            "usr_id": "{usr_id}"
          }
        },
        {
          "op": "compute_totp_code",
          "input": {
            "secret": "{secret}"
          },
          "captures": {
            "code1": "code"
          }
        },
        {
          "op": "verify_mfa",
          "input": {
            "usr_id": "{usr_id}",
            "proof": {
              "type": "totp",
              "code": "{code1}"
            }
          },
          "expected": {
            "error": "InvalidCredentialError"
          }
        }
      ]
    },
